# ========================================
# RAILWAY FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Copy variabel di bawah ke Railway Dashboard:
# Frontend Service → Variables → Raw Editor
# ========================================

# API Configuration
# PENTING: Ganti dengan URL backend Railway Anda
# Format: https://your-backend-service.up.railway.app/api
VITE_API_URL=${{server.RAILWAY_PUBLIC_DOMAIN}}/api

# App Configuration
VITE_APP_NAME=RBM System
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=production

# Build Configuration
NODE_ENV=production

# ========================================
# CARA SETUP DI RAILWAY:
# ========================================
#
# 1. Buka Railway Dashboard
# 2. Pilih Frontend Service
# 3. Klik tab "Variables"
# 4. Klik "Raw Editor"
# 5. Copy paste variabel di atas
# 6. Ganti ${{server.RAILWAY_PUBLIC_DOMAIN}} dengan URL backend
#    Contoh: https://rbm-backend-production.up.railway.app/api
# 7. Klik "Add" atau "Update"
# 8. Frontend akan auto-redeploy
#
# ========================================
# CARA DAPAT URL BACKEND:
# ========================================
#
# 1. Buka Backend Service di Railway
# 2. Klik tab "Settings"
# 3. Scroll ke "Networking" → "Public Networking"
# 4. Copy domain yang ada (contoh: rbm-backend-production.up.railway.app)
# 5. Tambahkan /api di belakang
# 6. Paste ke VITE_API_URL
#
# ========================================
