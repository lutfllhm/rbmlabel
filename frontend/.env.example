# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================

# API Configuration
# Local Development: Tidak perlu diset (otomatis ke http://localhost:5000/api)
# Railway Production: Set ke URL backend Railway
# Format: https://your-backend-service.up.railway.app/api
VITE_API_URL=

# App Configuration
VITE_APP_NAME=RBM System
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# ========================================
# CARA SETUP:
# ========================================
#
# LOCAL DEVELOPMENT:
# 1. Copy file ini ke .env
# 2. Kosongkan VITE_API_URL (atau hapus baris tersebut)
# 3. Frontend akan otomatis connect ke http://localhost:5000/api
#
# RAILWAY PRODUCTION:
# 1. Jangan commit .env ke Git
# 2. Set variables di Railway Dashboard → Variables → Raw Editor
# 3. VITE_API_URL=https://your-backend.railway.app/api
# 4. VITE_NODE_ENV=production
#
# ========================================
