# ========================================
# RAILWAY ENVIRONMENT VARIABLES
# ========================================
# Copy the variables below to Railway Dashboard:
# Service Settings → Variables → Raw Editor
# ========================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration - Railway MySQL (Single Unified Database)
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=railway
SQL_FILE_PATH=/app/server/database/rbm_combined.sql
FORCE_DB_INIT=true

# JWT Configuration
JWT_SECRET=09ee1f18127fcb5ef381397098c5a2c768a37ee6ab6186b063aa54f352dc42e7bcf4eb96598e53a5e1ea800cc8f64052439f5c048221d4393d8035c2ee8f9c5e
JWT_EXPIRE=7d
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=*
CLIENT_URL=${{RAILWAY_PUBLIC_DOMAIN}}

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Webhook Security (only if using external integrations)
WEBHOOK_SECRET_MATERIAL=rbm-material-webhook-2024
WEBHOOK_SECRET_STOKLABEL=rbm-stoklabel-webhook-2024
WEBHOOK_SECRET_LPS=rbm-lps-webhook-2024

# ========================================
# COPY EVERYTHING ABOVE TO RAILWAY
# ========================================

# ========================================
# DEPLOYMENT INSTRUCTIONS:
# ========================================
# 
# 1. Copy all variables above (from NODE_ENV to WEBHOOK_SECRET_LPS)
# 2. Go to Railway Dashboard → Your Service → Variables
# 3. Click "Raw Editor" 
# 4. Paste the variables
# 5. Click "Add" or "Update"
# 6. Wait for automatic redeploy
#
# IMPORTANT NOTES:
# - Uses SINGLE unified database: rbm_combined
# - Make sure MySQL service is named "MySQL" in Railway
# - Database and all tables will be created automatically
# - CORS_ORIGIN set to "*" for initial testing
# - Change JWT_SECRET for production security if needed
# - Webhook secrets are optional (only for external integrations)
#
# MYSQL SERVICE SETUP:
# 1. Add MySQL service in Railway
# 2. Make sure service name is "MySQL" (case-sensitive)
# 3. Railway will automatically provide connection variables
#
# GENERATE NEW JWT SECRET (optional):
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# DATABASE STRUCTURE:
# - Single database: rbm_combined
# - Contains all tables for Material, Stoklabel, and LPS modules
# - Automatically initialized from rbm_combined.sql
#
# ========================================
