.env
.env.local
.env.development
.env.test

# Node modules (will be installed during build)
node_modules/
frontend/node_modules/
server/node_modules/

# Development builds
frontend/dist/
server/public/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

